<Application
    x:Class="Pesu.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="PesuPaper">#FFF6F3EE</Color>
            <Color x:Key="PesuSidebar">#FFEEE8DE</Color>
            <Color x:Key="PesuAccent">#FFE15B4D</Color>
            <Color x:Key="PesuInk">#FF1D1A16</Color>
            <Color x:Key="PesuMuted">#FF6A6257</Color>
            <SolidColorBrush x:Key="PesuPaperBrush" Color="{StaticResource PesuPaper}" />
            <SolidColorBrush x:Key="PesuSidebarBrush" Color="{StaticResource PesuSidebar}" />
            <SolidColorBrush x:Key="PesuAccentBrush" Color="{StaticResource PesuAccent}" />
            <SolidColorBrush x:Key="PesuInkBrush" Color="{StaticResource PesuInk}" />
            <SolidColorBrush x:Key="PesuMutedBrush" Color="{StaticResource PesuMuted}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
