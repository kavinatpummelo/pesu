<Page
    x:Class="Pesu.Windows.Pages.PastPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light">
    <Grid Padding="48,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="HISTORY" Foreground="{StaticResource PesuMutedBrush}" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Text="Past meetings" FontSize="52" FontFamily="Times New Roman" Foreground="{StaticResource PesuInkBrush}" />
        </StackPanel>

        <ListView Grid.Row="1" Margin="0,24,0,0" ItemsSource="{Binding PastMeetings}" Background="Transparent" BorderThickness="0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,12" Padding="16" CornerRadius="12" Background="White">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding StartedAt}" Foreground="{StaticResource PesuMutedBrush}" />
                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{StaticResource PesuMutedBrush}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
