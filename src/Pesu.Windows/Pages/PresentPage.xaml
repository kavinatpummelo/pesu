<Page
    x:Class="Pesu.Windows.Pages.PresentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light">
    <Grid Padding="48,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="TODAY" Foreground="{StaticResource PesuMutedBrush}" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="Good day." FontSize="56" FontFamily="Times New Roman" Foreground="{StaticResource PesuInkBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Content="New Recording" Height="40" MinWidth="140" Click="NewRecording_Click" />
        </Grid>

        <TextBlock Grid.Row="1" Text="Today's meetings" Margin="0,28,0,10" FontWeight="SemiBold" />

        <ListView Grid.Row="2" ItemsSource="{Binding PresentMeetings}" Background="Transparent" BorderThickness="0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,12" Padding="16" CornerRadius="12" Background="White">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding StartedAt}" Foreground="{StaticResource PesuMutedBrush}" />
                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{StaticResource PesuMutedBrush}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
