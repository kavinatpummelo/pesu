<Page
    x:Class="Pesu.Windows.Pages.RecordingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light">
    <Grid Padding="48,36">
        <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
            <TextBlock Text="RECORDING" Foreground="{StaticResource PesuMutedBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Live local capture" FontSize="48" FontFamily="Times New Roman" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding CaptureStatus}" HorizontalAlignment="Center" Foreground="{StaticResource PesuMutedBrush}" />

            <Border Padding="18" Background="White" CornerRadius="12">
                <TextBlock
                    Text="During implementation this panel will show live transcript fragments with final-segment replacement, matching the mac app flow."
                    TextWrapping="Wrap"
                    Foreground="{StaticResource PesuMutedBrush}" />
            </Border>

            <Button Content="Stop recording" HorizontalAlignment="Center" MinWidth="180" Click="StopRecording_Click" />
        </StackPanel>
    </Grid>
</Page>
