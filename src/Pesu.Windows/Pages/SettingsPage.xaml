<Page
    x:Class="Pesu.Windows.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Padding="48,36" Spacing="18">
            <TextBlock Text="PREFERENCES" Foreground="{StaticResource PesuMutedBrush}" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Text="Settings" FontSize="52" FontFamily="Times New Roman" Foreground="{StaticResource PesuInkBrush}" />

            <Border Padding="22" CornerRadius="12" Background="White">
                <StackPanel Spacing="8">
                    <TextBlock Text="Calendar" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CalendarStatus}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CalendarDetail}" TextWrapping="Wrap" Foreground="{StaticResource PesuMutedBrush}" />
                    <Button Content="Connect / Refresh" HorizontalAlignment="Left" Padding="16,8" />
                </StackPanel>
            </Border>

            <Border Padding="22" CornerRadius="12" Background="White">
                <StackPanel Spacing="8">
                    <TextBlock Text="Recording" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Choose microphone and local retention options." Foreground="{StaticResource PesuMutedBrush}" />
                    <ComboBox PlaceholderText="System default microphone" Width="260" />
                    <CheckBox Content="Keep local audio files" IsChecked="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
