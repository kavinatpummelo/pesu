<Page
    x:Class="Pesu.Windows.Pages.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Padding="48,36" Spacing="14">
            <TextBlock Text="YOUR MEETING YEAR" Foreground="{StaticResource PesuMutedBrush}" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Text="Time, in perspective" FontSize="52" FontFamily="Times New Roman" Foreground="{StaticResource PesuInkBrush}" />

            <Grid Margin="0,18,0,0" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Padding="18" CornerRadius="12" Background="White">
                    <StackPanel>
                        <TextBlock Text="Completed meetings" Foreground="{StaticResource PesuMutedBrush}" />
                        <TextBlock Text="24" FontSize="36" FontFamily="Times New Roman" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Padding="18" CornerRadius="12" Background="White">
                    <StackPanel>
                        <TextBlock Text="Total meeting time" Foreground="{StaticResource PesuMutedBrush}" />
                        <TextBlock Text="18h 40m" FontSize="36" FontFamily="Times New Roman" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Padding="18" CornerRadius="12" Background="White">
                    <StackPanel>
                        <TextBlock Text="Average meeting" Foreground="{StaticResource PesuMutedBrush}" />
                        <TextBlock Text="47 min" FontSize="36" FontFamily="Times New Roman" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Padding="18" CornerRadius="12" Background="White">
                    <StackPanel>
                        <TextBlock Text="Days with meetings" Foreground="{StaticResource PesuMutedBrush}" />
                        <TextBlock Text="17" FontSize="36" FontFamily="Times New Roman" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
